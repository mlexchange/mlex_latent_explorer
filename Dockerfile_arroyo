FROM python:3.11

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies in a separate layer so they're cached until pyproject.toml changes
COPY pyproject.toml README.md ./
RUN mkdir -p src && uv pip install --system --no-cache ".[arroyo]"

# Source changes only rebuild from here
COPY . /app
RUN uv pip install --system --no-cache --no-deps .

ENTRYPOINT ["python", "-m", "arroyopy.cli", "run"]